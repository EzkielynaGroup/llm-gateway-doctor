{
  "name": "llm-gateway-doctor",
  "version": "0.1.0",
  "description": "Conformance checks for OpenAI- and Anthropic-compatible LLM endpoints: streaming, tool calls, usage, errors. Terminal, JSON, HTML report and SVG badge.",
  "type": "module",
  "bin": {
    "llm-gateway-doctor": "bin/llm-gateway-doctor.mjs"
  },
  "files": [
