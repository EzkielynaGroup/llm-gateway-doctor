    "cli",
    "vllm",
    "ollama",
    "litellm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EzkielynaGroup/llm-gateway-doctor.git"
  },
  "homepage": "https://github.com/EzkielynaGroup/llm-gateway-doctor#readme",
